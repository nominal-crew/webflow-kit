# Consuming project — copy into the Webflow site repo, not this package.
# The plugin reads process.env at runtime (Vite + CLI). Nothing is bundled.

# R2 (required for upload)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public CDN origin — passed to the plugin as `cdn` (no trailing slash)
PUBLIC_ASSET_URL=

# Optional R2 folders — default staging / production under {name}/
R2_STAGING_PREFIX=
R2_PRODUCTION_PREFIX=

# Optional — defaults to `name` in webflow.config.js
PROJECT_ID=

# Published Webflow staging URL — opened by `pnpm dev` with ?nc-env=dev
WEBFLOW_STAGING_URL=https://your-site.webflow.io

# Upload staging JS + CSS during `pnpm dev` (default: true)
# WEBFLOW_SYNC_STAGING=true
